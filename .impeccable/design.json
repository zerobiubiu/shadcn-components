  "components": [
    {
      "name": "Aurora Button — Default",
      "kind": "button",
      "refersTo": "button-aurora-default",
      "description": "默认变体：晨雾面 + 墨黑字，药丸形。真实组件的光晕角度由 rAF 逐帧写入 CSS 变量并朝向鼠标；此处为静态近似（hover 时整圈光谱淡入并旋转）。",
      "html": "<button class='ds-ad' type='button'><span class='ds-ad-surface'></span><span class='ds-ad-label'>Default</span></button>",
      "css": ".ds-ad{position:relative;display:inline-flex;align-items:center;justify-content:center;height:36px;padding:0 8px;border:0;background:transparent;border-radius:100px;font-family:var(--font-sans,ui-sans-serif,system-ui,sans-serif);font-size:14px;line-height:1;font-weight:400;cursor:pointer}.ds-ad::before{content:'';position:absolute;inset:-1px;border-radius:inherit;background:conic-gradient(#3186ff 34%,#9378ff 37%,#f96bd6 39%,#fc413d 41%,#fc413d 48%,#ff6b2b 50%,#fec700 52%,#ffdb0f 56%,#88de42 58%,#0ebc5f 61%,#0ebc5f 65%,#2eaab2 70%,#00a9bb 72%,#3186ff 73%,#3186ff 83%,#3186ff 100%);filter:blur(4px);opacity:0;rotate:0deg;transition:opacity .35s ease,rotate .6s cubic-bezier(0,0,0,1);z-index:0;pointer-events:none}.ds-ad:hover::before,.ds-ad:focus-visible::before{opacity:.6;rotate:225deg}.ds-ad-surface{position:absolute;inset:1px;border-radius:100px;background:#f0f4f9;transition:filter .15s;z-index:1}.ds-ad:hover .ds-ad-surface{filter:blur(2px)}.ds-ad:focus-visible{outline:none}.ds-ad:focus-visible .ds-ad-surface{outline:2px solid #1a73e8;outline-offset:2px}.ds-ad-label{position:relative;z-index:2;display:inline-flex;align-items:center;justify-content:center;gap:6px;color:#1f1f1f}"
    },
    {
      "name": "Aurora Button — Highlighted",
      "kind": "button",
      "refersTo": "button-aurora-highlighted",
      "description": "强调变体：天青面 + 深海蓝字，是体系内唯一的静态彩色组合（The One Light Rule 的例外之一）。",
      "html": "<button class='ds-ah' type='button'><span class='ds-ah-surface'></span><span class='ds-ah-label'>Highlighted</span></button>",
      "css": ".ds-ah{position:relative;display:inline-flex;align-items:center;justify-content:center;height:36px;padding:0 8px;border:0;background:transparent;border-radius:100px;font-family:var(--font-sans,ui-sans-serif,system-ui,sans-serif);font-size:14px;line-height:1;font-weight:400;cursor:pointer}.ds-ah::before{content:'';position:absolute;inset:-1px;border-radius:inherit;background:conic-gradient(#3186ff 34%,#9378ff 37%,#f96bd6 39%,#fc413d 41%,#fc413d 48%,#ff6b2b 50%,#fec700 52%,#ffdb0f 56%,#88de42 58%,#0ebc5f 61%,#0ebc5f 65%,#2eaab2 70%,#00a9bb 72%,#3186ff 73%,#3186ff 83%,#3186ff 100%);filter:blur(4px);opacity:0;rotate:0deg;transition:opacity .35s ease,rotate .6s cubic-bezier(0,0,0,1);z-index:0;pointer-events:none}.ds-ah:hover::before,.ds-ah:focus-visible::before{opacity:.6;rotate:225deg}.ds-ah-surface{position:absolute;inset:1px;border-radius:100px;background:#d3e3fd;transition:filter .15s;z-index:1}.ds-ah:hover .ds-ah-surface{filter:blur(2px)}.ds-ah:focus-visible{outline:none}.ds-ah:focus-visible .ds-ah-surface{outline:2px solid #1a73e8;outline-offset:2px}.ds-ah-label{position:relative;z-index:2;display:inline-flex;align-items:center;justify-content:center;gap:6px;color:#0b57d0}"
